    "@tiptap/react": "3.35.0",
    "@tiptap/starter-kit": "3.35.0",
    "i18next": "27.2.3",
    "lucide-react": "1.77.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "18.0.3",
    "zustand": "5.1.0"
  },
  "devDependencies": {
