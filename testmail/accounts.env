# Local test server (scripts/testmail.sh). These are NOT secrets: the accounts
# exist only on the Stalwart instance under testmail/.data/, which listens on
# 127.0.0.1 only. Never put real credentials here.
#
# Load into a shell:   set -a; . testmail/accounts.env; set +a
# Plain KEY=VALUE lines (with optional "export"), so dotenv parsers work too.
# Login names are the full addresses.

export TESTMAIL_HOST=127.0.0.1
# Name in the server certificate (the certificate also covers 127.0.0.1 and ::1).
export TESTMAIL_TLS_NAME=localhost
# Test CA that signed the server certificate; relative to the repository root.
# Clients must load it explicitly; it is never added to a system trust store.
export TESTMAIL_CA_FILE=testmail/.data/tls/ca.pem

# IMAP with STARTTLS (LOGIN is refused before STARTTLS).
export TESTMAIL_IMAP_PORT=1143
# IMAP with implicit TLS.
export TESTMAIL_IMAPS_PORT=1993
# SMTP submission with STARTTLS, AUTH required.
export TESTMAIL_SUBMISSION_PORT=1587
# SMTP submission with implicit TLS, AUTH required.
export TESTMAIL_SMTPS_PORT=1465
# SMTP without AUTH, accepts mail for local recipients only (STARTTLS offered).
export TESTMAIL_SMTP_PORT=1025
# HTTP without TLS: JMAP and the Stalwart management API.
export TESTMAIL_HTTP_PORT=18080
# HTTPS (implicit TLS): JMAP for the client (stage 14, decision 0041). The session resource is
# https://localhost:18443/.well-known/jmap; the server names its API on https://localhost:18443.
export TESTMAIL_HTTPS_PORT=18443

export TESTMAIL_DOMAIN=vicemail.test
export TESTMAIL_ALICE_ADDRESS=alice@vicemail.test
export TESTMAIL_ALICE_PASSWORD=alice-test-pw
export TESTMAIL_BOB_ADDRESS=bob@vicemail.test
export TESTMAIL_BOB_PASSWORD=bob-test-pw
# Server administrator (management API on the HTTP port); has a mailbox too.
export TESTMAIL_ADMIN_ADDRESS=admin@vicemail.test
export TESTMAIL_ADMIN_PASSWORD=admin-test-pw

# Base URL for external images in seeded HTML mails (a spike counts hits there).
export TESTMAIL_IMAGE_HOST=http://127.0.0.1:18999/
